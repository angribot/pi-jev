{
  "name": "pi-jev",
  "version": "0.1.0",
  "description": "Single-file pi extension for batched TypeSafe Jev judgments",
  "keywords": [
    "jev",
    "judgment",
    "pi",
    "pi-extension",
    "pi-package",
    "typesafe"
  ],
  "homepage": "https://github.com/angribot/pi-jev#readme",
  "bugs": {
    "url": "https://github.com/angribot/pi-jev/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angribot/pi-jev.git"
  },
  "files": [
    "pi-jev.ts",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint pi-jev.ts test",
    "format:check": "oxfmt --check pi-jev.ts test README.md package.json tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.0.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./pi-jev.ts"
    ]
  }
}
